# ——— روابط الإيميل (مهم لزر التفعيل) ———
# عنوان الـ API العام. روابط التفعيل في الإيميل تفتح على هذا الرابط.
# ⚠️ لازم يكون عنوان الـ API (NestJS) اللي شغال — مش رابط الفرونتند (Vercel).
# لو هنا رابط Vercel أو deployment غلط → الضغط على الزر يعطي 404 DEPLOYMENT_NOT_FOUND.
# أمثلة صحيحة: https://your-api.railway.app  أو  https://api.yourdomain.com  أو  http://localhost:3000
API_PUBLIC_URL=

# بديل: لو ما حطيت API_PUBLIC_URL، بيتستخدم APP_URL (كمان لازم يكون رابط الـ API)
APP_URL=

# ——— البريد (Gmail أو غيره) ———
MAIL_USER=
MAIL_PASS=

# ——— JWT ———
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# ——— قاعدة البيانات ———
DATABASE_URL=

# ——— البورت (اختياري) ———
PORT=3000
