# ——— روابط الإيميل (مهم لزر التفعيل) ———
# عنوان الـ API العام. روابط التفعيل واستعادة الباسورد في الإيميل تفتح على هذا الرابط.
# لازم يكون عنوان السيرفر اللي عليه الـ NestJS (مش الفرونتند على Vercel).
# مثال: https://your-api.railway.app أو https://api.yourdomain.com
API_PUBLIC_URL=

# بديل: لو ما حطيت API_PUBLIC_URL، بيتستخدم APP_URL
APP_URL=

# بعد تفعيل الحساب بنجاح: إعادة توجيه المستخدم لصفحة (مثلاً صفحة تسجيل الدخول)
# مثال: https://your-frontend.vercel.app/login?verified=1
# لو ما حطيت: الـ API يرجع JSON فقط
VERIFY_SUCCESS_REDIRECT_URL=

# ——— البريد (Gmail أو غيره) ———
MAIL_USER=
MAIL_PASS=

# ——— JWT ———
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# ——— قاعدة البيانات ———
DATABASE_URL=

# ——— البورت (اختياري) ———
PORT=3000
