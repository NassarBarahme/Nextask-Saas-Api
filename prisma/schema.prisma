generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model PendingUser {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String   // الباسورد المشفر
  otpCode   String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  password    String
  name        String?
  phone       String?      @unique
  isActive    Boolean      @default(true)
  activeOrganizationId  String?
  refreshToken    String?
  memberships Membership[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
otpCode           String?
  otpExpires        DateTime?
  isVerified Boolean  @default(false)
}

model Organization {
  id             String       @id @default(uuid())
  name           String
  slug           String       @unique
  type           OrgType
  metadata       Json?        @default("{}")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  memberships    Membership[]
  items          Item[]
  placedOrders   Order[]      @relation("BuyerRelation")
  receivedOrders Order[]      @relation("SellerRelation")
  deliveryOrders Order[]      @relation("DeliveryRelation")
}

model Membership {
  id             String       @id @default(uuid())
  role           Role         @default(MEMBER)
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

model Item {
  id             String       @id @default(uuid())
  name           String
  description    String?
  price          Decimal      @db.Decimal(10, 2)
  comparePrice   Decimal?      @db.Decimal(10, 2)
  sku            String?
  barcode        String?
  stock          Int          @default(0)
  unit           String       @default("piece")
  attributes     Json?        @default("{}")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  orderItems     OrderItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, barcode])
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     Int           @unique @default(autoincrement())
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  buyerId         String
  buyer           Organization  @relation("BuyerRelation", fields: [buyerId], references: [id])
  sellerId        String
  seller          Organization  @relation("SellerRelation", fields: [sellerId], references: [id])
  deliveryId      String?
  delivery        Organization? @relation("DeliveryRelation", fields: [deliveryId], references: [id])
  subTotal        Decimal       @db.Decimal(10, 2)
  deliveryFee     Decimal       @db.Decimal(10, 2) @default(0)
  platformFee     Decimal       @db.Decimal(10, 2) @default(0)
  totalPrice      Decimal       @db.Decimal(10, 2)
  shippingAddress Json?
  notes           String?
  orderItems      OrderItem[]
  history         Json?         @default("[]")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([buyerId])
  @@index([sellerId])
  @@index([deliveryId])
}

model OrderItem {
  id       String  @id @default(uuid())
  orderId  String
  itemId   String
  quantity Int
  price    Decimal @db.Decimal(10, 2)
  order    Order   @relation(fields: [orderId], references: [id])
  item     Item    @relation(fields: [itemId], references: [id])

  @@unique([orderId, itemId])
}

enum OrgType {
  RETAIL
  WHOLESALE
  LOGISTICS
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}
